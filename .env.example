# E-Commerce Microservice local environment sample
# This file contains placeholder values only. Do not put real secrets here.

ASPNETCORE_ENVIRONMENT=Development

# Gateway
API_GATEWAY_HTTP_PORT=5000

# Service ports for local debugging
ORDER_SERVICE_HTTP_PORT=5001
PRODUCT_SERVICE_HTTP_PORT=5002
PAYMENT_SERVICE_HTTP_PORT=5003
NOTIFICATION_SERVICE_HTTP_PORT=5004

# Databases
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB_ORDER=order_db
POSTGRES_DB_PRODUCT=product_db
POSTGRES_DB_PAYMENT=payment_db
POSTGRES_DB_HANGFIRE=hangfire_db
MONGO_CONNECTION_STRING=mongodb://localhost:27017/notification_db

# Infrastructure
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_CONNECTION_STRING=localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Identity
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ecommerce
KEYCLOAK_AUDIENCE=ecommerce-api

# Observability
SEQ_URL=http://localhost:5341
OTLP_ENDPOINT=http://localhost:4317
JAEGER_UI_URL=http://localhost:16686
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000

